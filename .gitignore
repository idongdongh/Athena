# ════════════════════════════════════════════════════════════════════
# Secrets —— 绝不进版本控制
# ════════════════════════════════════════════════════════════════════
# .env 含 API keys（ANTHROPIC_API_KEY / TAVILY_API_KEY 等），进 git 即永久泄漏。
# 公开仓库尤其严格——push 一旦上去，即使后删，Git 历史仍可被爬虫抓取。
.env
.env.local
.env.*.local

# ════════════════════════════════════════════════════════════════════
# Python —— 缓存 + 字节码
# ════════════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so

# ════════════════════════════════════════════════════════════════════
# 虚拟环境 —— 各开发者在本地 `pip install -r requirements.txt` 自己建
# ════════════════════════════════════════════════════════════════════
.venv/
venv/
env/
ENV/

# ════════════════════════════════════════════════════════════════════
# 运行产物 —— tracer 输出、实验数据（运行时生成，不入库）
# ════════════════════════════════════════════════════════════════════
logs/

# ════════════════════════════════════════════════════════════════════
# 用户自有产物 —— 不进公开 repo（交接文档 §五"不动用户自有"铁律）
# ════════════════════════════════════════════════════════════════════
# rag.py 含个人桌面路径；test.py 是临时调试；notebook 下的实验产物是个人笔记
rag.py
test.py
notebook/当前问题.md
notebook/anthropic_res_json/
notebook/test_result_json/
notebook/glob_tool_ast.txt
AGENT_HANDOFF.md

# .DS_Store（macOS 系统文件）
.DS_Store

# Claude / IDE 配置（个人偏好）
.claude/
.idea/
.vscode/
*.swp
